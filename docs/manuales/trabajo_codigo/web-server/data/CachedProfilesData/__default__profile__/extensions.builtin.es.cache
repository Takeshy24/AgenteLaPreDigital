 merge","group":"1_modification"}],"editor/title":[{"command":"merge-conflict.previous","group":"navigation@1","when":"!isMergeEditor && mergeConflictsCount && mergeConflictsCount != 0"},{"command":"merge-conflict.next","group":"navigation@2","when":"!isMergeEditor && mergeConflictsCount && mergeConflictsCount != 0"}]},"configuration":{"title":"Fusionar conflicto","properties":{"merge-conflict.codeLens.enabled":{"type":"boolean","description":"Cree CodeLens para los bloques de conflictos de fusión mediante combinación en el editor.","default":true},"merge-conflict.decorators.enabled":{"type":"boolean","description":"Cree elementos Decorator para los bloques de conflictos de fusión mediante combinación en el editor.","default":true},"merge-conflict.autoNavigateNextConflict.enabled":{"type":"boolean","description":"Indica si, después de resolver un conflicto de fusión mediante combinación, se va automáticamente al siguiente conflicto de este tipo.","default":false},"merge-conflict.diffViewPosition":{"type":"string","enum":["Current","Beside","Below"],"description":"Controla dónde se debe abrir la vista de diferencias al comparar los cambios en los conflictos de combinación.","enumDescriptions":["Abra la vista de diferencias en el grupo de editor actual.","Abra la vista de diferencias junto al grupo de editor actual.","Abra la vista de diferencias debajo del grupo de editor actual."],"default":"Current"}}}},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1,"path":"/c:/Users/USERJSSV/Downloads/AgenteLaPreDigital/docs/manuales/trabajo_codigo/web-cli/serve-web/69047191fc427f2f92828279aae1d90d8eeda7ab/extensions/merge-conflict","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.mermaid-markdown-features"},"manifest":{"name":"mermaid-markdown-features","displayName":"Características de Mermaid Markdown",