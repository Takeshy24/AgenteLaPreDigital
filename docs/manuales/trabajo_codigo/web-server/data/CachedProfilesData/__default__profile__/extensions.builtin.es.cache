om","when":"!mermaidError && (webviewId == 'vscode.mermaid-markdown-features.chatOutputItem' || webviewId == 'vscode.mermaid-markdown-features.preview')","group":"navigation@3"}]},"configuration":{"title":"Mermaid","properties":{"markdown-mermaid.lightModeTheme":{"order":0,"type":"string","enum":["vscode","base","forest","dark","default","neutral"],"enumDescriptions":["Tema Mermaid de fondo derivado del tema de color VS Code actual.","Tema Mermaid integrado. El único Tema Mermaid que se puede personalizar con variables de tema.","Tema Mermaid integrado con tonos de verde.","Tema Mermaid integrado para fondos oscuros.","El Tema Mermaid también integrado predeterminado. Funciona bien con fondos claros.","Tema Mermaid integrado con una paleta de escala de grises neutra. Adecuado para copias impresas en blanco y negro."],"default":"vscode","description":"Tema predeterminado de Mermaid para el modo claro."},"markdown-mermaid.darkModeTheme":{"order":1,"type":"string","enum":["vscode","base","forest","dark","default","neutral"],"enumDescriptions":["Tema Mermaid de fondo derivado del tema de color VS Code actual.","Tema Mermaid integrado. El único Tema Mermaid que se puede personalizar con variables de tema.","Tema Mermaid integrado con tonos de verde.","Tema Mermaid integrado para fondos oscuros.","El Tema Mermaid también integrado predeterminado. Funciona bien con fondos claros.","Tema Mermaid integrado con una paleta de escala de grises neutra. Adecuado para copias impresas en blanco y negro."],"default":"vscode","description":"Tema predeterminado de Mermaid para el modo oscuro."},"markdown-mermaid.languages":{"order":2,"type":"array","default":["mermaid"],"description":"Idiomas predeterminados en Markdown."},"markdown-mermaid.maxTextSize":{"order":3,"type":"number","default":50000,"description":"Tamaño máximo permitido del diagrama de texto del usuario."},"markdown-mermaid.mouseNavigation.enabled":{"type":"string","description":"Controla cuándo se habilita la navegación con el ratón en los diagramas de Mermaid.","enum":["always","alt","never"],"default":"alt","markdownEnumDescriptions":["Habilite siempre la navegación con el ratón en los diagramas de Mermaid.","Habilite solo la navegación del mouse al mantener presionada la tecla Alt (opción en macOS). Los gestos como reducir a zoom seguirán funcionando sin Alt.","Deshabilitar la navegación con el ratón."]},"markdown-mermaid.controls.show":{"type":"string","description":"Controles que muestran la interfaz de usuario en diagramas de Mermaid.","enum":["never","onHoverOrFocus","always"],"enumDescriptions":["No mostrar nunca controles.","Mostrar los controles de zoom al mantener el mouse sobre un diagrama o al centrarse en él.","Mostrar siempre los controles de zoom."],"default":"onHoverOrFocus"},"markdown-mermaid.resizable":{"type":"boolean","default":true,"description":"Permite cambiar el tamaño de los diagramas verticalmente arrastrando el borde inferior."},"markdown-mermaid.maxHeight":{"type":"string","default":"","markdownDescription":"Alto máximo para diagramas. Debe ser un valor CSS con unidades como `80vh` o `400px`. Déjelo vacío para intentar cambiar automáticamente el tamaño de los diagramas en función de su contenido."}}},"markdown.previewScripts":[{"path":"./markdown-preview-out/index.js","type":"module"}],"markdown.codeBlockEditorProviders":[{"id":"mermaid","selector":{"language":"mermaid"},"source":{"kind":"exportApi","apiVersion":1},"contentType":"text"}],"notebookRenderer":[{"id":"vscode.markdown-it.mermaid-extension","displayName":"Markdown-It Mermaid Renderer","requiresMessaging":"optional","entrypoint":{"extends":"vscode.markdown-it-renderer","path":"./notebook-out/index.js"}}],"markdown.markdownItPlugins":true,"chatOutputRenderers":[{"viewType":"vscode.mermaid-markdown-features.chatOutputItem","mimeTypes":["text/vnd.mermaid"],"codeBlockLanguageIdentifiers":["mermaid"]}],"languageModelTools":[{"name":"renderMermaidDiagram","displayName":"Mermaid Renderer","toolRefer