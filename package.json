{
  "name": "lapredigital-lead-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "up": "node tools/up.mjs",
    "up:check": "node tools/up.mjs --check",
    "db:clean": "node tools/clean-db.mjs",
    "db:watch": "node tools/watch-db.mjs",
    "check:mail": "node tools/check-mail.mjs",
    "test": "node --test --test-concurrency=1 --import ./server/tests/env.mjs",
    "format": "prettier --write . && node tools/format-sql.mjs",
    "format:check": "prettier --check . && node tools/format-sql.mjs --check",
    "migrate": "node tools/migrate.mjs",
    "knowledge:init": "node tools/knowledge.mjs",
    "check:ollama": "node tools/check-ollama.mjs",
    "seed:scenarios": "node tools/seed-scenarios.mjs",
    "seed:indicators": "node tools/seed-indicators.mjs",
    "datamart:init": "node tools/datamart.mjs init",
    "datamart:refresh": "node tools/datamart.mjs refresh",
    "datamart:rebuild": "node tools/datamart.mjs rebuild",
    "eval:agent": "node tools/eval-agent.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.2",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^2.15.0",
    "typescript": "~5.8.3",
    "vite": "latest",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "sql-formatter": "^15.9.0"
  }
}
