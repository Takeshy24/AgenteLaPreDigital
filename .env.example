DB_SERVER=localhost
DB_DATABASE=LaPreDigital_OLTP
DB_TRUST_CERTIFICATE=true
PORT=3067
# Autenticación integrada de Windows. No se necesitan usuario ni contraseña.
# Adaptador local mediante System.Data.SqlClient (.NET / Windows PowerShell).
# Opcional: usuario SQL (si no se configura, se usa Windows)
# DB_USER=
# DB_PASSWORD=
# El frontend utiliza la API por defecto. Para abrir el prototipo anterior:
# VITE_DATA_MODE=demo

# Telegram: crear el bot en BotFather y guardar el token solo aquí.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Ollama local: modelo encontrado en el equipo al implementar la integración.
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Activar cuando se desee ejecutar la agenda periódica y el bot esté configurado.
FOLLOWUP_ENABLED=false
FOLLOWUP_INTERVAL_MS=60000

# Stripe Checkout de prueba. Nunca usar claves sk_live_ en este proyecto local.
STRIPE_SECRET_KEY=
# stripe listen --forward-to localhost:3067/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Para abrir el portal en otro dispositivo, configurar una URL HTTPS y un proxy de confianza.
# PUBLIC_ORIGIN=https://tu-dominio.example
# BIND_HOST=0.0.0.0

# Landing pública con el túnel ngrok (npm run server detrás de `ngrok http 3067`).
# PUBLIC_ORIGIN habilita solo /api/public/*; la consola sigue limitada a localhost.
# PUBLIC_ORIGIN=https://tu-dominio.ngrok-free.dev
# Páginas alojadas en otro origen (por ejemplo Vercel) autorizadas a llamar a /api/public/*:
# LANDING_ORIGINS=https://tu-proyecto.vercel.app
# Frontend: vacío usa la API del mismo origen (trabajo local). Con la URL pública, la página
# usa esa API. En Vercel se define junto con VITE_SITE=landing.
# VITE_API_URL=https://tu-dominio.ngrok-free.dev
# VITE_SITE=landing

# Correo (SMTP) para enviar el enlace de Telegram a correos ya registrados.
# Gmail: activa la verificacion en dos pasos y crea una clave de aplicacion en
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=LaPreDigital <tu-cuenta@gmail.com>

# Base remota (otro servidor o la nube) para npm run db:clean -- --remote / --global.
# REMOTE_DB_SERVER=servidor-remoto,1433
# REMOTE_DB_DATABASE=LaPreDigital_OLTP
# REMOTE_DB_USER=
# REMOTE_DB_PASSWORD=
